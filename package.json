{
  "name": "rest",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run generate --workspace @rest/db",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
