# ─────────────────────────────────────────────────────────────────────────────
# Config de producción de "rest" → copiar a la raíz del repo como `.env`:
#     cp deploy/.env.prod.example .env
# Todo lo que empieza con NEXT_PUBLIC_ se hornea en BUILD: si lo cambias,
# re-ejecuta `docker compose -f docker-compose.prod.yml build` y `up -d`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres (red interna de rest-prod; sin puertos al host) ──
POSTGRES_USER=rest
POSTGRES_PASSWORD=CAMBIA-ESTO-largo-y-aleatorio
POSTGRES_DB=rest

# ── Aplicación ──
# Secreto de sesiones: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=CAMBIA-ESTO-32-bytes-hex
# true SOLO cuando el acceso sea por HTTPS real (túnel Cloudflare o dominio con TLS)
COOKIE_SECURE=false
# Orígenes de las PWA autorizados por el CORS del API (separados por coma)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# URL pública del panel/API que verán las tablets (la usan pos/kds/carta en build)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Slug del restaurante (se crea al registrarte en /signup; también define el header X-Org-Slug)
NEXT_PUBLIC_ORG_SLUG=cevicheria-el-muelle
# URL pública del panel (metadatos/SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:8080
# true = arranca con la Cevichería El Muelle demo (maria@cevicheriaelmuelle.pe / demo1234)
# false = DB vacía: el dueño se registra en /signup y empieza a operar. SOLO afecta el
#         primer arranque (con organizaciones existentes no vuelve a sembrar).
DEMO_SEED=true

# ── Caddy (modo LAN/debug; los 80/443 del host quedan para otros stacks) ──
API_DOMAIN=api.localhost
POS_DOMAIN=pos.localhost
KDS_DOMAIN=kds.localhost
CARTA_DOMAIN=carta.localhost
REST_HTTP_PORT=8080
REST_HTTPS_PORT=8443

# ── Cloudflare Tunnel (opcional, RECOMENDADO para tablets reales) ──
# docker compose -f docker-compose.prod.yml --profile tunnel up -d
# Crea el tunnel en el dashboard y mapea:
#   api.TUDOMINIO → http://rest-web:3000 · pos.TUDOMINIO → http://rest-pos:3001
#   kds.TUDOMINIO → http://rest-kds:3002 · carta.TUDOMINIO → http://rest-menu:3003
CLOUDFLARE_TUNNEL_TOKEN=

# ── Plataforma (superadmin) ──
# Email que nace/borna como dueño de la plataforma (/superadmin). Obligatorio
# para que TÚ tengas el control: regístrate en /signup con este email.
SUPERADMIN_EMAIL=dueno@tudominio.pe
# false = registro cerrado: nadie se crea cuentas sin tu ok (recomendado
# mientras no haya billing automático). true = self-serve abierto.
SIGNUP_OPEN=true

# ── Auth de dispositivos (PWA) ──
# true = las tablets DEBEN presentar su X-Device-Token (provisionado en
# /superadmin → restaurante → Dispositivos). Recomendado en operación real.
DEVICE_AUTH=false
